{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semeia-leads",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  // App React (pasta dist) + API no mesmo Worker. A entrada "/" e as rotas /api/* passam primeiro pelo Worker ("/" decide entre a página de apresentação e o app).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "semeia-leads", "database_id": "41fa0c8d-488a-47ff-a20f-05bbb66ef05f", "migrations_dir": "migrations" }
  ],
  // Domínio próprio (decidir com o Neto; a zona precisa estar na conta Cloudflare). Exemplo:
  // "routes": [{ "pattern": "leads.seudominio.com.br", "custom_domain": true }],
  // Fotos de produto (vêm em base64 do ERP; o índice fica no D1)
  "r2_buckets": [{ "binding": "IMAGENS", "bucket_name": "semeia-leads-imagens" }],
  // ADMINS: e-mails dos administradores da plataforma (veem todas as empresas), separados por vírgula
  "vars": { "APP_NAME": "Semeia Leads", "ADMINS": "alcyjvneto@gmail.com,gruposemeiadigital@gmail.com", "ASAAS_URL": "https://api.asaas.com/v3", "VAPID_PUBLIC_KEY": "BDMYRzFdY3t7IPhzEX_54UnTz4zz9h-nKJsBLIieTcQGRqTezbG0Ed9PJUitbx7BaVUSQOmJ1iuUuZa-56NeI2I", "VAPID_SUBJECT": "mailto:gruposemeiadigital@gmail.com" },
  // Sync com o ERP: a cada 15 min (pedidos recentes; cadastros às 05h UTC = 02h Brasília; continua cargas pela metade)
  "triggers": { "crons": ["*/15 * * * *"] },
  // segredos (não ficam no código): npx wrangler secret put SECRETS_KEY · ASAAS_API_KEY · ASAAS_WEBHOOK_TOKEN
  // (ASAAS_API_KEY de teste `$aact_hmlg_…` usa o sandbox sozinha)
  // SECRETS_KEY = 32 bytes em base64: openssl rand -base64 32
  "observability": { "enabled": true }
}
